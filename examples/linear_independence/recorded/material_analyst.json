    {
      "id": "F2",
      "concept_id": "C2",
      "latex": "\\operatorname{span}\\{v_1,\\dots,v_k\\} = \\{\\, c_1v_1+\\cdots+c_kv_k : c_1,\\dots,c_k \\in \\mathbb{R} \\,\\}",
      "meaning": "계수를 모든 실수로 바꿔 가며 만든 일차결합 전체의 집합",
      "variables": [
        {
          "symbol": "c_i",
          "meaning": "자유롭게 고를 수 있는 실수 계수"
        }
      ],
      "conditions": [],
      "status": "observed",
      "confidence": 0.95,
      "evidence": [
        {
          "chunk_id": "slides#003",
          "quote": "span{v1, ..., vk} = { c1v1 + ... + ckvk : c1, ..., ck ∈ R }"
        }
      ],
      "rationale": ""
    },
    {
      "id": "F3",
      "concept_id": "C3",
