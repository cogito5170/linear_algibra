  "definitions": [
    {
      "id": "D1",
      "concept_id": "C1",
      "term": "일차결합",
      "statement": "벡터 v1, ..., vk ∈ V와 스칼라 c1, ..., ck에 대해 c1v1 + c2v2 + ... + ckvk를 v1, ..., vk의 일차결합이라 한다.",
      "conditions": [
        "v1, ..., vk는 벡터공간 V의 벡터",
        "c1, ..., ck는 스칼라"
      ],
      "status": "observed",
      "confidence": 0.95,
      "evidence": [
        {
          "chunk_id": "slides#002",
          "quote": "를 v1, ..., vk 의 일차결합이라 한다."
        }
      ],
      "rationale": ""
    },
    {
      "id": "D2",
      "concept_id": "C2",
      "term": "span",
      "statement": "span{v1, ..., vk}는 v1, ..., vk의 모든 일차결합의 집합이다.",
      "conditions": [
        "계수 c1, ..., ck는 실수 전체(R)를 움직인다"
      ],
      "status": "observed",
      "confidence": 0.95,
      "evidence": [
        {
          "chunk_id": "slides#003",
          "quote": "v1, ..., vk 의 모든 일차결합의 집합."
        }
      ],
      "rationale": ""
    },
    {
      "id": "D3",
      "concept_id": "C3",
      "term": "일차독립 / 일차종속",
      "statement": "c1v1 + ... + ckvk = 0 이면 반드시 c1 = ... = ck = 0일 때 v1, ..., vk는 일차독립이다. 그렇지 않으면(모두 0은 아닌 계수로 영벡터를 만들 수 있으면) 일차종속이다.",
      "conditions": [
        "'이면'의 방향: 영벡터가 되는 모든 경우에 계수가 전부 0이어야 한다"
      ],
      "status": "observed",
      "confidence": 0.95,
      "evidence": [
        {
          "chunk_id": "slides#004",
          "quote": "v1, ..., vk 는 일차독립이라 한다."
        },
        {
          "chunk_id": "slides#004",
          "quote": "그렇지 않으면 일차종속이라 한다."
        }
      ],
      "rationale": ""
    }
  ],
