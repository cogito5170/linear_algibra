            "type": "string",
            "pattern": "^C\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "자료에서 이 개념이 무엇으로 다뤄지는지 한두 문장",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "uncertain"
            ],
            "description": "observed: 자료에 실제로 있음 / inferred: 자료 구조로부터 합리적으로 추론 / uncertain: 자료만으로 판단 어려움"
          },
          "confidence": {
            "type": "number",
            "description": "0~1 사이 확신도",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "chunk_id": {
                  "type": "string",
                  "description": "인용한 source chunk의 id (입력 bundle에 존재해야 함)",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "description": "chunk 원문에서 그대로 복사한 짧은 인용. 바꿔 쓰지 않는다.",
                  "minLength": 1
                }
              },
              "required": [
                "chunk_id",
                "quote"
